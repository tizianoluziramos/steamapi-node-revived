{
  "name": "steamapi-node-revived",
  "version": "1.0.0",
  "description": "TypeScript client for the Steam Web API, Steam Community and the Steam Store",
  "author": "tizianoluziramos",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/require.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/require.d.cts",
        "default": "./dist/require.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "keywords": [
    "steam",
    "steamworks",
    "steamcommunity",
    "steam-web-api",
    "typescript"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test .test-build/test/*.test.js",
    "test:coverage": "npm run build:test && node --test --experimental-test-coverage --test-coverage-include=\".test-build/src/**/*.js\" --test-coverage-exclude=\"**/catalog-data.js\" --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=75 .test-build/test/*.test.js",
    "check": "npm run typecheck && npm run test:coverage && npm run build",
    "prepack": "npm run build",
    "build:test": "node -e \"require('node:fs').rmSync('.test-build', { recursive: true, force: true })\" && tsc -p tsconfig.test.json",
    "test:package": "npm run build:test && node .test-build/scripts/test-package.js"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}

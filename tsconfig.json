{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "ESNext"
    ],
    "module": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "removeComments": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ]
}
